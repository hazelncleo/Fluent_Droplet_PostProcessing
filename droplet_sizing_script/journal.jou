;fluent 3ddp -i journal.jou -gu -tn -driver null


/file/set-batch-options yes yes no
/mesh/adapt/set/method/hanging-node
/file/convert-hanging-nodes-during-read?/no

/define/user-defined/use-built-in-compiler? yes
/define/user-defined/compiled-functions compile vof_droplet_sizing yes "vof_droplet_sizing.c" "" "vof_droplet_sizing.h" ""

/rc "data/data_1.cas.h5"
/rd "data/data_1.dat.h5"

/mesh/adapt/set/method/hanging-node
/file/convert-hanging-nodes-during-read?/no

;add udm
/define/user-defined/user-defined-memory 1

;compile udf
/define/user-defined/compiled-functions load vof_droplet_sizing

;run on-demand
;/define/user-defined/execute-on-demand "droplet_sizes_ondemand::vof_droplet_sizing"
/define/user-defined/execute-on-demand "n_cell_threads::vof_droplet_sizing"

exit yes
/exit yes



