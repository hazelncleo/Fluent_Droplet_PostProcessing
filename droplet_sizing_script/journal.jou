;fluent 3ddp -i journal.jou -gu -t1 -driver null

/file/set-batch-options yes yes no
/mesh/adapt/set/method/hanging-node
/file/convert-hanging-nodes-during-read?/no

/rc "data/data_1.cas.h5"
/rd "data/data_1.dat.h5"

/mesh/adapt/set/method/hanging-node
/file/convert-hanging-nodes-during-read?/no

;add udm
/define/user-defined/user-defined-memory 2

;hook udf
/define/user-defined/compiled-functions unload libudf
/define/user-defined/use-built-in-compiler? yes
/define/user-defined/compiled-functions compile libudf yes "multithreaded.c" "stack.c" "data_storage.c" "node_host.c" "node_zero.c" "" "data_storage.h" "stack.h" "multithreaded.h" "node_zero.h" "node_host.h" ""

;compile udf
/define/user-defined/compiled-functions load libudf

;run on-demand
/define/user-defined/execute-on-demand "calculate_droplet_sizes::libudf"

exit yes
/exit yes



